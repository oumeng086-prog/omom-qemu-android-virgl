From: oumeng086-prog <oumeng086-prog@users.noreply.github.com>
Subject: [PATCH 1/2] ui/egl: support surfaceless EGL platforms for
 android/headless hosts

egl_rendernode_init() requires a DRM render node through
qemu_drm_rendernode_open()/gbm_create_device().  Hosts that expose GL/GLES
only through a surfaceless platform (Android applications, some container
images) have no /dev/dri/renderD*, so -display egl-headless fails to
initialise at all.

Fall back to EGL_PLATFORM_SURFACELESS_MESA when no render node is available:

  * choose pbuffer-only configs, which is the single surface type a
    surfaceless platform advertises;
  * request an OpenGL ES 3 context.  The display shaders in ui/shader are
    "#version 300 es", so an ES2 context is not sufficient;
  * keep FBO creation, use and destruction on the display context, since
    GLES3 shares textures between contexts but not framebuffer objects.

No change for hosts that do provide a render node.

Signed-off-by: oumeng086-prog <oumeng086-prog@users.noreply.github.com>
---
# Android: use surfaceless EGL platform, pbuffer configs, ES3 context
# and bind the display GL context around egl-headless FBO operations.

--- a/ui/egl-helpers.c
+++ b/ui/egl-helpers.c
@@ -121,9 +121,15 @@
         glGenFramebuffers(1, &fb->framebuffer);
     }
 
+#ifdef __ANDROID__
+    glBindFramebuffer(GL_FRAMEBUFFER, fb->framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, fb->texture, 0);
+#else
     glBindFramebuffer(GL_FRAMEBUFFER_EXT, fb->framebuffer);
     glFramebufferTexture2DEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT,
                               GL_TEXTURE_2D, fb->texture, 0);
+#endif
 }
 
 void egl_fb_setup_new_tex(egl_fb *fb, int width, int height)
@@ -539,12 +545,19 @@
     return dpy;
 }
 
+#ifdef __ANDROID__
+/* surfaceless platform only advertises pbuffer configs */
+#define QEMU_EGL_SURFACE_TYPE EGL_PBUFFER_BIT
+#else
+#define QEMU_EGL_SURFACE_TYPE EGL_WINDOW_BIT
+#endif
+
 static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
                              EGLenum platform,
                              DisplayGLMode mode)
 {
     static const EGLint conf_att_core[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_SURFACE_TYPE, QEMU_EGL_SURFACE_TYPE,
         EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
@@ -553,8 +566,12 @@
         EGL_NONE,
     };
     static const EGLint conf_att_gles[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+        EGL_SURFACE_TYPE, QEMU_EGL_SURFACE_TYPE,
+#ifdef __ANDROID__
+        EGL_RENDERABLE_TYPE, 0x00000040 /* EGL_OPENGL_ES3_BIT */,
+#else
         EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+#endif
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
         EGL_BLUE_SIZE,  5,
@@ -620,6 +637,21 @@
 }
 #endif
 
+#ifdef __ANDROID__
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+int qemu_egl_init_dpy_android(DisplayGLMode mode)
+{
+    /* No GBM/DRM render node on Android.  mesa's surfaceless platform works
+     * headless and can reach the GPU through zink -> vulkan -> kgsl. */
+    (void)mode;
+    return qemu_egl_init_dpy(EGL_DEFAULT_DISPLAY,
+                             EGL_PLATFORM_SURFACELESS_MESA,
+                             DISPLAY_GL_MODE_ES);
+}
+#endif
+
 
 #ifdef WIN32
 int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode)
@@ -676,7 +708,11 @@
         EGL_NONE
     };
     static const EGLint ctx_att_gles[] = {
+#ifdef __ANDROID__
+        EGL_CONTEXT_CLIENT_VERSION, 3,
+#else
         EGL_CONTEXT_CLIENT_VERSION, 2,
+#endif
         EGL_NONE
     };
     bool gles = (qemu_egl_mode == DISPLAY_GL_MODE_ES);
@@ -720,8 +756,16 @@
     }
 #elif defined(CONFIG_GBM)
     if (egl_rendernode_init(rendernode, mode) < 0) {
+#ifdef __ANDROID__
+        if (qemu_egl_init_dpy_android(mode) < 0) {
+            error_setg(errp, "egl: android egl init failed");
+            return false;
+        }
+        qemu_egl_rn_ctx = qemu_egl_init_ctx();
+#else
         error_setg(errp, "egl: render node init failed");
         return false;
+#endif
     }
 #endif
 
@@ -752,3 +796,30 @@
         qemu_egl_display = NULL;
     }
 }
+
+bool qemu_egl_rn_ctx_enter(EGLDisplay *prev_dpy, EGLContext *prev_ctx,
+                           EGLSurface *prev_draw, EGLSurface *prev_read)
+{
+    *prev_dpy  = eglGetCurrentDisplay();
+    *prev_ctx  = eglGetCurrentContext();
+    *prev_draw = eglGetCurrentSurface(EGL_DRAW);
+    *prev_read = eglGetCurrentSurface(EGL_READ);
+    if (eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       qemu_egl_rn_ctx) != EGL_TRUE) {
+        error_report("%s: bind qemu_egl_rn_ctx failed: 0x%x", __func__, eglGetError());
+        return false;
+    }
+    return true;
+}
+
+void qemu_egl_rn_ctx_leave(EGLDisplay prev_dpy, EGLContext prev_ctx,
+                           EGLSurface prev_draw, EGLSurface prev_read)
+{
+    if (prev_ctx != EGL_NO_CONTEXT) {
+        if (eglMakeCurrent(prev_dpy, prev_draw, prev_read, prev_ctx) != EGL_TRUE) {
+            error_report("%s: restore prev ctx failed: 0x%x", __func__, eglGetError());
+        }
+    } else {
+        eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+}
--- a/ui/console-gl.c
+++ b/ui/console-gl.c
@@ -106,6 +106,11 @@
     GLenum err = glGetError();
     *texture = 0;
     *mem_obj = 0;
+#ifdef __ANDROID__
+    /* no dma-buf import path on Android/GLES; blob=off does not need it */
+    (void)err;
+    return false;
+#endif
 
     if (!epoxy_has_gl_extension("GL_EXT_memory_object") ||
         !epoxy_has_gl_extension("GL_EXT_memory_object_fd")) {
@@ -114,7 +119,7 @@
         return false;
     }
 
-#ifdef GL_EXT_memory_object_fd
+#if defined(GL_EXT_memory_object_fd) && !defined(__ANDROID__)
     glCreateMemoryObjectsEXT(1, mem_obj);
     glImportMemoryFdEXT(*mem_obj, size, GL_HANDLE_TYPE_OPAQUE_FD_EXT, fd);
 
--- a/ui/egl-headless.c
+++ b/ui/egl-headless.c
@@ -51,9 +51,14 @@
 static void egl_scanout_disable(DisplayChangeListener *dcl)
 {
     egl_dpy *edpy = container_of(dcl, egl_dpy, dcl);
+    EGLDisplay p_dpy; EGLContext p_ctx; EGLSurface p_draw, p_read;
 
+    if (!qemu_egl_rn_ctx_enter(&p_dpy, &p_ctx, &p_draw, &p_read)) {
+        return;
+    }
     egl_fb_destroy(&edpy->guest_fb);
     egl_fb_destroy(&edpy->blit_fb);
+    qemu_egl_rn_ctx_leave(p_dpy, p_ctx, p_draw, p_read);
 }
 
 static void egl_scanout_texture(DisplayChangeListener *dcl,
