From 94f028f81a1cb8a5c6ef8500e11328ffb89059f5 Mon Sep 17 00:00:00 2001
From: oumeng <q15817976513@163.com>
Date: Mon, 26 Oct 2026 02:51:23 +0800
Subject: [PATCH] ui/egl: add a surfaceless platform fallback for headless
 hosts

egl_init() reaches the GPU through a DRM render node: egl_rendernode_init()
opens one with qemu_drm_rendernode_open() and builds a gbm device from it.
A host that exposes GL/GLES without /dev/dri/renderD* - an application
sandbox on Android is one, a container without device passthrough is
another - therefore cannot use -display egl-headless at all; init fails with
"egl: no drm render node available".

Fall back to EGL_MESA_platform_surfaceless when the render node is missing.
Two details differ from the window-system platforms:

  * a surfaceless display only advertises pbuffer configs, so the config
    cannot ask for EGL_WINDOW_BIT;
  * the display shaders in ui/shader are "#version 300 es", so the GLES
    renderable has to be EGL_OPENGL_ES3_BIT rather than EGL_OPENGL_ES2_BIT.

Both are passed into qemu_egl_init_dpy() instead of being hardcoded, so the
X11/GBM/Win32 paths keep their existing behaviour.

Tested on an aarch64 Android host: -display egl-headless,gl=es reaches the
GPU through Mesa's surfaceless platform, and the guest's SurfaceFlinger
reports "virgl (zink Vulkan ... ), OpenGL ES 3.2".

Signed-off-by: oumeng <q15817976513@163.com>
---
 include/ui/egl-helpers.h |  1 +
 ui/egl-helpers.c         | 67 ++++++++++++++++++++++++++++++++--------
 2 files changed, 55 insertions(+), 13 deletions(-)

diff --git a/include/ui/egl-helpers.h b/include/ui/egl-helpers.h
index 533d9af..aa03215 100644
--- a/include/ui/egl-helpers.h
+++ b/include/ui/egl-helpers.h
@@ -70,6 +70,7 @@ EGLDisplay qemu_egl_get_display(EGLNativeDisplayType native,
 
 int qemu_egl_init_dpy_x11(EGLNativeDisplayType dpy, DisplayGLMode mode);
 int qemu_egl_init_dpy_mesa(EGLNativeDisplayType dpy, DisplayGLMode mode);
+int qemu_egl_init_dpy_surfaceless(DisplayGLMode mode);
 
 #endif
 
diff --git a/ui/egl-helpers.c b/ui/egl-helpers.c
index cb9c1e8..d3057ae 100644
--- a/ui/egl-helpers.c
+++ b/ui/egl-helpers.c
@@ -542,10 +542,12 @@ EGLDisplay qemu_egl_get_display(EGLNativeDisplayType native,
 
 static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
                              EGLenum platform,
-                             DisplayGLMode mode)
+                             DisplayGLMode mode,
+                             EGLint surface_type,
+                             EGLint gles_renderable)
 {
-    static const EGLint conf_att_core[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
+    EGLint conf_att_core[] = {
+        EGL_SURFACE_TYPE, surface_type,
         EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
@@ -553,9 +555,9 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
         EGL_ALPHA_SIZE, 0,
         EGL_NONE,
     };
-    static const EGLint conf_att_gles[] = {
-        EGL_SURFACE_TYPE, EGL_WINDOW_BIT,
-        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+    EGLint conf_att_gles[] = {
+        EGL_SURFACE_TYPE, surface_type,
+        EGL_RENDERABLE_TYPE, gles_renderable,
         EGL_RED_SIZE,   5,
         EGL_GREEN_SIZE, 5,
         EGL_BLUE_SIZE,  5,
@@ -605,22 +607,51 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
 int qemu_egl_init_dpy_x11(EGLNativeDisplayType dpy, DisplayGLMode mode)
 {
 #ifdef EGL_KHR_platform_x11
-    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_X11_KHR, mode);
+    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_X11_KHR, mode,
+                             EGL_WINDOW_BIT, EGL_OPENGL_ES2_BIT);
 #else
-    return qemu_egl_init_dpy(dpy, 0, mode);
+    return qemu_egl_init_dpy(dpy, 0, mode,
+                             EGL_WINDOW_BIT, EGL_OPENGL_ES2_BIT);
 #endif
 }
 
 int qemu_egl_init_dpy_mesa(EGLNativeDisplayType dpy, DisplayGLMode mode)
 {
 #ifdef EGL_MESA_platform_gbm
-    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_GBM_MESA, mode);
+    return qemu_egl_init_dpy(dpy, EGL_PLATFORM_GBM_MESA, mode,
+                             EGL_WINDOW_BIT, EGL_OPENGL_ES2_BIT);
 #else
-    return qemu_egl_init_dpy(dpy, 0, mode);
+    return qemu_egl_init_dpy(dpy, 0, mode,
+                             EGL_WINDOW_BIT, EGL_OPENGL_ES2_BIT);
 #endif
 }
 #endif
 
+/*
+ * Headless hosts without a DRM render node (e.g. an application sandbox on
+ * Android, where /dev/dri is not available at all) can still reach the GPU
+ * through Mesa's surfaceless platform.  That platform advertises pbuffer
+ * configs only, so the config cannot ask for EGL_WINDOW_BIT, and the
+ * display shaders in ui/shader are "#version 300 es", so an ES3 renderable
+ * is required rather than ES2.
+ */
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+#ifndef EGL_OPENGL_ES3_BIT
+#define EGL_OPENGL_ES3_BIT 0x00000040
+#endif
+
+int qemu_egl_init_dpy_surfaceless(DisplayGLMode mode)
+{
+    return qemu_egl_init_dpy(EGL_DEFAULT_DISPLAY,
+                             EGL_PLATFORM_SURFACELESS_MESA,
+                             mode == DISPLAY_GL_MODE_ON ?
+                             DISPLAY_GL_MODE_ES : mode,
+                             EGL_PBUFFER_BIT,
+                             EGL_OPENGL_ES3_BIT);
+}
+
 
 #ifdef WIN32
 int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode)
@@ -630,7 +661,8 @@ int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode)
         mode = DISPLAY_GL_MODE_ES;
     }
 
-    if (qemu_egl_init_dpy(dpy, 0, mode) < 0) {
+    if (qemu_egl_init_dpy(dpy, 0, mode,
+                          EGL_WINDOW_BIT, EGL_OPENGL_ES2_BIT) < 0) {
         return -1;
     }
 
@@ -721,8 +753,17 @@ bool egl_init(const char *rendernode, DisplayGLMode mode, Error **errp)
     }
 #elif defined(CONFIG_GBM)
     if (egl_rendernode_init(rendernode, mode) < 0) {
-        error_setg(errp, "egl: render node init failed");
-        return false;
+        /* No DRM render node: try the surfaceless platform before giving up */
+        if (qemu_egl_init_dpy_surfaceless(mode) < 0) {
+            error_setg(errp, "egl: render node init failed");
+            return false;
+        }
+        qemu_egl_rn_ctx = qemu_egl_init_ctx();
+        if (!qemu_egl_rn_ctx) {
+            error_setg(errp, "egl: egl_init_ctx failed");
+            return false;
+        }
+        return true;
     }
 #endif
 
-- 
2.53.0

